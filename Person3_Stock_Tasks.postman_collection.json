        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"supplierId\": 1,\n  \"batchCode\": \"BATCH-2026-TEST\",\n  \"quantity\": 50,\n  \"expiryDate\": \"2027-12-31\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/inventory/batches/stock-in",
          "host": ["{{baseUrl}}"],
          "path": ["inventory", "batches", "stock-in"]
        }
      }
