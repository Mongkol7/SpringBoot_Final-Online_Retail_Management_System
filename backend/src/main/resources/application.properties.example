# ===================================================================
# Spring Boot Online Retail Management System — Example Configuration
# Copy this file to application.properties and customize credentials.
# ===================================================================

# Server Port & API Context Path
server.port=8080
server.servlet.context-path=/api/v1

# Application Identity
spring.application.name=online-retail-management-system

# Database Connection (PostgreSQL 18)
# Replace host, port, database name, username and password as appropriate
spring.datasource.url=jdbc:postgresql://localhost:5432/E-bookstrore_db
spring.datasource.username=postgres
spring.datasource.password=123
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate ORM Settings
# ddl-auto options: 'validate' (recommended for production with Flyway), 'none', 'update'
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.jdbc.batch_size=25

# Flyway Database Migration
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.locations=classpath:db/migration

# JSON Web Token (JWT) Security Configuration
# secret: 256-bit hexadecimal or Base64 secret key
app.jwt.secret=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# 86400000 ms = 24 hours
app.jwt.expiration-ms=86400000
# 604800000 ms = 7 days
app.jwt.refresh-expiration-ms=604800000
